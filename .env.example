# --- Frontend (Next.js) ---
# WalletConnect Cloud project ID — https://cloud.walletconnect.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Optional RPC overrides (defaults are set in code per chain)
NEXT_PUBLIC_ARC_RPC_URL=https://rpc.testnet.arc.network
NEXT_PUBLIC_BASE_RPC_URL=https://mainnet.base.org
NEXT_PUBLIC_MONAD_RPC_URL=https://rpc.monad.xyz

# --- Arc testnet (chain 5042002) ---
NEXT_PUBLIC_USDC_ADDRESS=0x3600000000000000000000000000000000000000
NEXT_PUBLIC_EURC_ADDRESS=0x89B50855Aa3bE2F677cD6303Cec089B5F319D72a
NEXT_PUBLIC_STABLE_VAULT_ADDRESS=0xcB8dd43D44c48925C7348a177229dFF11Fd1Ec27

# --- Base mainnet (chain 8453) — Circle USDC + EURC ---
NEXT_PUBLIC_BASE_USDC_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
NEXT_PUBLIC_BASE_EURC_ADDRESS=0x60a3E35Cc302bFA44Cb288Bc5a4F316Fdb1adb42
# Set after `npm run deploy:stable-vault:base`
NEXT_PUBLIC_BASE_VAULT_ADDRESS=

# --- Monad mainnet (chain 143) — Circle USDC + EURW placeholder ---
NEXT_PUBLIC_MONAD_USDC_ADDRESS=0x754704Bc059F8C67012fEd69BC8A327a5aafb603
NEXT_PUBLIC_MONAD_EURW_ADDRESS=0x1111b3ded9f1fe1801ad4ebef8e2788183a24111
# Set after `npm run deploy:stable-vault:monad`
NEXT_PUBLIC_MONAD_VAULT_ADDRESS=

# --- Yield Vaults (ERC-4626 staking) ---
# Set after `npm run deploy:yield-vault` on each network
NEXT_PUBLIC_ARC_USDC_YIELD_VAULT=
NEXT_PUBLIC_ARC_EUR_YIELD_VAULT=
NEXT_PUBLIC_BASE_USDC_YIELD_VAULT=
NEXT_PUBLIC_BASE_EUR_YIELD_VAULT=
NEXT_PUBLIC_MONAD_USDC_YIELD_VAULT=
NEXT_PUBLIC_MONAD_EUR_YIELD_VAULT=
# Optional: set to a multisig (Safe) to deploy with that owner. Defaults to the deployer EOA.
VAULT_OWNER=

# --- Forex Pool (Arc testnet only) ---
# Oracle-priced USDC<->EURC AMM with shared LP shares. Rate pushed by server keeper.
NEXT_PUBLIC_ARC_FOREX_POOL=
# Legacy single-owner trader — superseded by ForexPool.
NEXT_PUBLIC_ARC_FOREX_TRADER=
# Server-only key used by /api/forex/push-price to call setPrice on the pool.
# Reuse DEPLOYER_PRIVATE_KEY or set a separate keeper key.
FOREX_KEEPER_PRIVATE_KEY=

# --- Base Forex Vault (Base mainnet only) ---
# Market-maker vault around Aerodrome USDC/EURC stable pool; 50 bps withdrawal fee → adminFees.
# Set after `npm run deploy:base-forex-vault`.
NEXT_PUBLIC_BASE_FOREX_VAULT=

# --- Forex Trading Agent (Base mainnet only) ---
# Keeper-driven USDC↔EURC rotation vault on Aerodrome. Deposit any mix, the
# off-chain signal bot swaps between the two based on EUR/USD momentum.
# `tradeFeeBps` (default 20 = 0.20%) of every swap goes to adminFees.
# Set after `npm run deploy:forex-agent:base`.
NEXT_PUBLIC_BASE_FOREX_AGENT=
# Server-only private key used by /api/agent/rebalance to call targetRebalance.
# If unset, the keeper route falls back to DEPLOYER_PRIVATE_KEY.
AGENT_KEEPER_PRIVATE_KEY=

# Optional: UI-only hint — USD price of 1 EURC for “market reference” on /swap
NEXT_PUBLIC_FX_HINT_USD_PER_EUR=1.08

# Optional: receive micro-payments from the UI. If unset, sends go to the connected wallet (testnet demo).
NEXT_PUBLIC_PROTOCOL_TREASURY=

# --- Contracts deploy (Hardhat) ---
ARC_RPC_URL=https://rpc.testnet.arc.network
BASE_RPC_URL=https://mainnet.base.org
MONAD_RPC_URL=https://rpc.monad.xyz
# Required for deploy scripts unless using accounts: "remote"
DEPLOYER_PRIVATE_KEY=

# Fund share metadata (optional)
VIBEFUND_SHARE_NAME=VibeFund Share
VIBEFUND_SHARE_SYMBOL=VFS
VIBEFUND_NFT_BASE_URI=https://vibefunds.xyz/nft/

# If set, deploy script also deploys FundManager
USDC_ADDRESS=0x3600000000000000000000000000000000000000

# For `deploy:stable-vault` — Arc defaults if unset. For Base/Monad, script uses canonical addresses unless overridden.
EURC_ADDRESS=0x89B50855Aa3bE2F677cD6303Cec089B5F319D72a
# Euro-side token on any network (EURC on Arc/Base, EURW on Monad)
EUR_STABLE_ADDRESS=
# Fixed euro-stable→USD price at deploy, 1e18 fixed point (default 1.08 USD per 1 unit)
EURC_USD_1E18=1080000000000000000

# --- Optional: Supabase sync (server only — never expose service role to the client) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
