# --- Frontend (Next.js) ---
# WalletConnect Cloud project ID — https://cloud.walletconnect.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Optional: override Arc RPC in the browser (defaults to https://rpc.testnet.arc.network in code)
NEXT_PUBLIC_ARC_RPC_URL=https://rpc.testnet.arc.network

# USDC on Arc testnet (set after you verify the official testnet contract from Circle / Arc docs)
NEXT_PUBLIC_USDC_ADDRESS=

# Optional: receive micro-payments from the UI. If unset, sends go to the connected wallet (testnet demo).
NEXT_PUBLIC_PROTOCOL_TREASURY=

# --- Contracts deploy (Hardhat) ---
# Used by `npm run deploy:arc` — must match Hardhat config variables
ARC_RPC_URL=https://rpc.testnet.arc.network
DEPLOYER_PRIVATE_KEY=

# Fund share metadata (optional)
VIBEFUND_SHARE_NAME=VibeFund Share
VIBEFUND_SHARE_SYMBOL=VFS
VIBEFUND_NFT_BASE_URI=https://vibefunds.xyz/nft/

# If set, deploy script also deploys FundManager
USDC_ADDRESS=

# --- Optional: Supabase sync (server only — never expose service role to the client) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
