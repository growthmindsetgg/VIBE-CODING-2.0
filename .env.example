# --- Frontend (Next.js) ---
# WalletConnect Cloud project ID — https://cloud.walletconnect.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Optional: override Arc RPC in the browser (defaults to https://rpc.testnet.arc.network in code)
NEXT_PUBLIC_ARC_RPC_URL=https://rpc.testnet.arc.network

# USDC on Arc testnet (native gas token contract on this chain)
NEXT_PUBLIC_USDC_ADDRESS=0x3600000000000000000000000000000000000000

# EURC on Arc testnet
NEXT_PUBLIC_EURC_ADDRESS=0x89B50855Aa3bE2F677cD6303Cec089B5F319D72a

# Optional: UI-only hint — USD price of 1 EURC for “market reference” on /swap (swaps are still AMM-priced from pool reserves)
NEXT_PUBLIC_FX_HINT_USD_PER_EUR=1.08

# Wallet allowed to see Pool “paste addresses” UI (optional). If set, other users only use env addresses + Swap.
NEXT_PUBLIC_POOL_DEPLOYER_ADDRESS=

# StableSwapMicroVault — set after `npm run deploy:stable-vault`
NEXT_PUBLIC_STABLE_VAULT_ADDRESS=

# Optional: receive micro-payments from the UI. If unset, sends go to the connected wallet (testnet demo).
NEXT_PUBLIC_PROTOCOL_TREASURY=

# --- Contracts deploy (Hardhat) ---
# Hardhat `arc-testnet` uses https://rpc.testnet.arc.network (optional override not required for deploy)
ARC_RPC_URL=https://rpc.testnet.arc.network
# Required for `npm run deploy:arc` / `deploy:stable-vault` unless you switch Hardhat to accounts: "remote"
DEPLOYER_PRIVATE_KEY=

# Fund share metadata (optional)
VIBEFUND_SHARE_NAME=VibeFund Share
VIBEFUND_SHARE_SYMBOL=VFS
VIBEFUND_NFT_BASE_URI=https://vibefunds.xyz/nft/

# If set, deploy script also deploys FundManager
USDC_ADDRESS=0x3600000000000000000000000000000000000000

# For `npm run deploy:stable-vault` — defaults match Arc testnet if unset
EURC_ADDRESS=0x89B50855Aa3bE2F677cD6303Cec089B5F319D72a
# Fixed EURC→USD price at deploy, 1e18 fixed point (default 1.08 USD per 1 EURC)
EURC_USD_1E18=1080000000000000000

# --- Optional: Supabase sync (server only — never expose service role to the client) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
